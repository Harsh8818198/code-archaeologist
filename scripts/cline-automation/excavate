#!/bin/bash
# Code Archaeologist CLI - Cline automation

API_URL="${API_URL:-http://localhost:3001}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
NC='\033[0m'

print_banner() {
    echo -e "${PURPLE}🏛️  CODE ARCHAEOLOGIST CLI${NC}"
    echo -e "${PURPLE}════════════════════════════${NC}"
    echo ""
}

analyze() {
    local repo_path="${1:-.}"
    local max_files="${2:-5}"
    
    repo_path="$(cd "$repo_path" 2>/dev/null && pwd)" || {
        echo -e "${RED}❌ Path does not exist${NC}"
        exit 1
    }
    
    print_banner
    echo -e "${BLUE}📂 Repository:${NC} $repo_path"
    echo -e "${BLUE}📊 Max Files:${NC} $max_files"
    echo -e "${YELLOW}🚀 Starting excavation...${NC}\n"
    
    response=$(curl -s -X POST "$API_URL/api/excavate" \
        -H "Content-Type: application/json" \
        -d "{\"repoPath\": \"$repo_path\", \"options\": {\"maxFiles\": $max_files}}")
    
    job_id=$(echo "$response" | grep -o '"jobId":"[^"]*"' | cut -d'"' -f4)
    
    if [ -z "$job_id" ]; then
        echo -e "${RED}❌ Failed${NC}"
        echo "$response"
        exit 1
    fi
    
    echo -e "${GREEN}✅ Job ID:${NC} $job_id\n"
    echo -e "${YELLOW}⏳ Polling for completion...${NC}\n"
    
    while true; do
        job=$(curl -s "$API_URL/api/jobs/$job_id")
        status=$(echo "$job" | grep -o '"status":"[^"]*"' | cut -d'"' -f4)
        progress=$(echo "$job" | grep -o '"progress":[0-9]*' | cut -d':' -f2)
        
        printf "\r  Progress: %3d%% - Status: %-15s" "${progress:-0}" "$status"
        
        if [ "$status" = "completed" ]; then
            echo -e "\n\n${GREEN}✅ Complete!${NC}\n"
            echo -e "View: ${BLUE}http://localhost:3000/results/$job_id${NC}\n"
            break
        elif [ "$status" = "failed" ]; then
            echo -e "\n\n${RED}❌ Failed${NC}\n"
            exit 1
        fi
        
        sleep 2
    done
}

help() {
    print_banner
    echo "Usage:"
    echo "  excavate analyze [path] [maxFiles]"
    echo "  excavate help"
    echo ""
    echo "Examples:"
    echo "  excavate analyze . 5"
    echo "  excavate analyze ~/projects/myrepo 10"
}

case "$1" in
    analyze) analyze "$2" "$3" ;;
    help|"") help ;;
    *) echo -e "${RED}Unknown: $1${NC}"; help; exit 1 ;;
esac
